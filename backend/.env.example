# Node Express Server Configuration
PORT=5001
NODE_ENV=development

# JWT Authentication Secret & Expiration
JWT_SECRET=finathon_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Supabase & PostgreSQL Configuration
# ------------------------------------------------------------------------------
# Option 1: Direct PostgreSQL / Supabase Pooler Connection String
# Found in: Supabase Dashboard > Project Settings > Database > Connection string > URI
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Option 2: Supabase REST API & Service Role (for SDK operations)
# Found in: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# Supabase Model Context Protocol (MCP) Server Configuration
# ------------------------------------------------------------------------------
# Access token generated from: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_PROJECT_REF=your-project-id
