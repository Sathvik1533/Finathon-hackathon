PORT=4000
NODE_ENV=development

# Required for production API authentication/database operation.
JWT_SECRET=
DATABASE_URL=

# Live Nova ingestion is not implemented in this repository. Keep unconfigured
# until a reviewed provider client is implemented and verified. Use demo only
# for local UI development; production explicitly ignores demo fixtures.
NOVA_MODE=unconfigured
NOVA_API_KEY=
NOVA_BASE_URL=https://www.aczen.in/nova-api/v1

REDIS_URL=
