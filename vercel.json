{
  "version": 2,
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/health",
      "destination": "/api/index.js"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/web/assets/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/web/index.html"
    }
  ]
}
